    { "id": 440, "en": "I'm of two minds", "ru": "Я в раздумьях", "category": "emotions", "level": "B2" },
    { "id": 441, "en": "I changed my mind", "ru": "Я передумал (передумала)", "category": "emotions", "level": "A2" },
    { "id": 442, "en": "It's up in the air", "ru": "Это ещё под вопросом", "category": "emotions", "level": "B2" },
    { "id": 443, "en": "I second that", "ru": "Я поддерживаю", "category": "emotions", "level": "B2" },
    { "id": 444, "en": "I couldn't agree more", "ru": "Полностью согласен (согласна)", "category": "emotions", "level": "B1" },
    { "id": 445, "en": "That's exactly what I think", "ru": "Я думаю точно так же", "category": "emotions", "level": "A2" },
    { "id": 446, "en": "I see your point", "ru": "Понимаю твою мысль", "category": "emotions", "level": "B1" },
    { "id": 447, "en": "I beg to differ", "ru": "Позволь не согласиться", "category": "emotions", "level": "B2" },
    { "id": 448, "en": "That's beside the point", "ru": "Это не по теме", "category": "emotions", "level": "B2" },
    { "id": 449, "en": "You have a point", "ru": "В этом ты прав (права)", "category": "emotions", "level": "B1" },
    { "id": 450, "en": "I'm not so sure about that", "ru": "Я в этом не так уверен (уверена)", "category": "emotions", "level": "B1" },
    { "id": 451, "en": "No offense, but...", "ru": "Без обид, но...", "category": "emotions", "level": "B1" },
    { "id": 452, "en": "None taken", "ru": "Никаких обид", "category": "emotions", "level": "B2" },
    { "id": 453, "en": "Guess what!", "ru": "Угадай, что!", "category": "emotions", "level": "A2" },
    { "id": 454, "en": "You're kidding!", "ru": "Да ладно тебе!", "category": "emotions", "level": "B1" },
    { "id": 455, "en": "That's awesome!", "ru": "Это потрясающе!", "category": "emotions", "level": "A1" },
    { "id": 456, "en": "How amazing is that?", "ru": "Ну разве не здорово?", "category": "emotions", "level": "B1" },
    { "id": 457, "en": "What a shame", "ru": "Какая жалость", "category": "emotions", "level": "B1" },
    { "id": 458, "en": "It's a pity", "ru": "Как жаль", "category": "emotions", "level": "B1" },
    { "id": 459, "en": "It can't be helped", "ru": "Ничего не поделаешь", "category": "emotions", "level": "B2" },
    { "id": 460, "en": "It is what it is", "ru": "Что есть, то есть", "category": "emotions", "level": "B2" },
    { "id": 500, "en": "Thank you so much", "ru": "Большое спасибо", "category": "politeness", "level": "A1" },
    { "id": 501, "en": "Thanks a lot", "ru": "Спасибо огромное", "category": "politeness", "level": "A1" },
    { "id": 502, "en": "Thank you anyway", "ru": "Всё равно спасибо", "category": "politeness", "level": "A2" },
    { "id": 503, "en": "I really appreciate it", "ru": "Я очень это ценю", "category": "politeness", "level": "A2" },
    { "id": 504, "en": "I can't thank you enough", "ru": "Не знаю, как тебя благодарить", "category": "politeness", "level": "B1" },
    { "id": 505, "en": "You're welcome", "ru": "Пожалуйста", "category": "politeness", "level": "A1" },
    { "id": 506, "en": "Don't mention it", "ru": "Не за что", "category": "politeness", "level": "B1" },
    { "id": 507, "en": "My pleasure", "ru": "С удовольствием помог", "category": "politeness", "level": "B1" },
    { "id": 508, "en": "No worries", "ru": "Без проблем", "category": "politeness", "level": "B1" },
    { "id": 509, "en": "Anytime", "ru": "Всегда пожалуйста", "category": "politeness", "level": "B1" },
    { "id": 510, "en": "Excuse me", "ru": "Извините", "category": "politeness", "level": "A1" },
    { "id": 511, "en": "Sorry to bother you", "ru": "Извините за беспокойство", "category": "politeness", "level": "B1" },
    { "id": 512, "en": "Sorry for being late", "ru": "Извини за опоздание", "category": "politeness", "level": "A2" },
    { "id": 513, "en": "Sorry, my bad", "ru": "Извини, моя вина", "category": "politeness", "level": "B1" },
    { "id": 514, "en": "My apologies", "ru": "Приношу извинения", "category": "politeness", "level": "B1" },
    { "id": 515, "en": "I owe you an apology", "ru": "Я должен (должна) извиниться", "category": "politeness", "level": "B1" },
    { "id": 516, "en": "It won't happen again", "ru": "Больше не повторится", "category": "politeness", "level": "B1" },
    { "id": 517, "en": "Never mind", "ru": "Ничего страшного", "category": "politeness", "level": "A2" },
    { "id": 518, "en": "That's all right", "ru": "Всё в порядке", "category": "politeness", "level": "A1" },
    { "id": 519, "en": "No harm done", "ru": "Никто не пострадал", "category": "politeness", "level": "B1" },
    { "id": 520, "en": "Forget it", "ru": "Забудь", "category": "politeness", "level": "B1" },
    { "id": 521, "en": "Please have a seat", "ru": "Пожалуйста, присаживайтесь", "category": "politeness", "level": "A2" },
    { "id": 522, "en": "After you", "ru": "После вас", "category": "politeness", "level": "B1" },
    { "id": 523, "en": "Make yourself at home", "ru": "Чувствуйте себя как дома", "category": "politeness", "level": "B1" },
    { "id": 524, "en": "Help yourself", "ru": "Угощайтесь", "category": "politeness", "level": "B1" },
    { "id": 525, "en": "Can I ask you a favor?", "ru": "Можно попросить об услуге?", "category": "politeness", "level": "A2" },
    { "id": 526, "en": "Could you do me a favor?", "ru": "Не могли бы вы мне помочь?", "category": "politeness", "level": "A2" },
    { "id": 527, "en": "Would you mind helping me?", "ru": "Вам не трудно мне помочь?", "category": "politeness", "level": "B1" },
    { "id": 528, "en": "Could you keep an eye on my bag?", "ru": "Присмотрите за моей сумкой?", "category": "politeness", "level": "B1" },
    { "id": 529, "en": "May I come in?", "ru": "Можно войти?", "category": "politeness", "level": "A1" },
    { "id": 530, "en": "May I ask you something?", "ru": "Можно вас спросить?", "category": "politeness", "level": "A1" },
    { "id": 531, "en": "Of course, go ahead", "ru": "Конечно, спрашивайте", "category": "politeness", "level": "A2" },
    { "id": 532, "en": "Feel free to ask", "ru": "Спрашивайте, не стесняйтесь", "category": "politeness", "level": "B1" },
    { "id": 533, "en": "Sorry to interrupt", "ru": "Извините, что перебиваю", "category": "politeness", "level": "B1" },
    { "id": 534, "en": "Go on, I'm listening", "ru": "Продолжай, я слушаю", "category": "politeness", "level": "A2" },
    { "id": 535, "en": "That's very kind of you", "ru": "Это очень любезно с вашей стороны", "category": "politeness", "level": "B1" },
    { "id": 536, "en": "You shouldn't have", "ru": "Не стоило (о подарке)", "category": "politeness", "level": "B1" },
    { "id": 537, "en": "It's the least I could do", "ru": "Это меньшее, что я мог (могла) сделать", "category": "politeness", "level": "B2" },
    { "id": 538, "en": "Bless you!", "ru": "Будьте здоровы!", "category": "politeness", "level": "A2" },
    { "id": 539, "en": "Have a nice day", "ru": "Хорошего дня", "category": "politeness", "level": "A1" },
    { "id": 540, "en": "Enjoy your meal", "ru": "Приятного аппетита", "category": "politeness", "level": "A1" },
    { "id": 541, "en": "Good luck!", "ru": "Удачи!", "category": "politeness", "level": "A1" },
    { "id": 542, "en": "Congratulations!", "ru": "Поздравляю!", "category": "politeness", "level": "A1" },
    { "id": 543, "en": "Well done!", "ru": "Молодец!", "category": "politeness", "level": "A1" },
    { "id": 544, "en": "Take your time", "ru": "Не торопись", "category": "politeness", "level": "A2" },
    { "id": 545, "en": "Come in, please", "ru": "Заходите, пожалуйста", "category": "politeness", "level": "A1" },
    { "id": 546, "en": "Mind your step", "ru": "Осторожно, ступенька", "category": "politeness", "level": "B1" },
    { "id": 547, "en": "Watch your head", "ru": "Не ударьтесь головой", "category": "politeness", "level": "B1" },
    { "id": 548, "en": "Allow me", "ru": "Позвольте мне", "category": "politeness", "level": "B1" },
    { "id": 549, "en": "With all due respect", "ru": "При всём уважении", "category": "politeness", "level": "B2" },
    { "id": 550, "en": "If you don't mind", "ru": "Если вы не против", "category": "politeness", "level": "B1" },
    { "id": 551, "en": "As you wish", "ru": "Как пожелаете", "category": "politeness", "level": "B1" },
    { "id": 552, "en": "Whatever you prefer", "ru": "Как вам удобнее", "category": "politeness", "level": "B1" },
    { "id": 553, "en": "It's very thoughtful of you", "ru": "Вы очень внимательны", "category": "politeness", "level": "B2" },
    { "id": 554, "en": "Much obliged", "ru": "Очень признателен (признательна)", "category": "politeness", "level": "B2" },
    { "id": 555, "en": "At your service", "ru": "К вашим услугам", "category": "politeness", "level": "B2" }
